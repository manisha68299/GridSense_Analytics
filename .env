# PostgreSQL connection settings
# Replace these placeholders with your real local/remote DB values.
# NEVER commit this file with real credentials — it's already in .gitignore.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=green_grid
DB_USER=postgres
DB_PASSWORD=Manisha55

# Open-Meteo doesn't require an API key, but keeping this here
# in case you later switch to a provider that does (e.g. OpenWeatherMap).
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1/forecast

# ETL scheduling
PIPELINE_INTERVAL_MINUTES=5